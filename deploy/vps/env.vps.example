# Plantilla de variables para despliegue en VPS.
# Copiar en la raíz del proyecto como .env antes de desplegar:
#   cp deploy/vps/env.vps.example .env
# Nunca subir .env al repositorio Git.

APP_NAME="SPS"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sps
POSTGRES_USER=sps
# Generar contraseña robusta: openssl rand -hex 24
POSTGRES_PASSWORD=

# Enlace detrás de proxy inverso (Caddy / Nginx en host): mantener en loopback
API_BIND_HOST=127.0.0.1
API_PORT=8000
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=4200
API_WORKERS=2

# Dominio público HTTPS para Caddy (--profile tls). Ejemplo: sps.tudominio.edu.co
SPS_DOMAIN=sps.tudominio.edu.co

# JWT e Identidad Institucional
# Generar secreto mínimo de 32 bytes: openssl rand -hex 32
IDENTITY_JWT_SECRET=
IDENTITY_JWT_ISSUER=sps-api
IDENTITY_JWT_AUDIENCE=sps
IDENTITY_JWT_MINUTES=15
# Lista JSON de dominios permitidos (ejemplo: ["@unihumboldt.edu.co","@gmail.com"])
IDENTITY_INSTITUTIONAL_DOMAINS=["@unihumboldt.edu.co"]

# Zona horaria IANA de los registros sin offset
PARTICIPATION_TIMESTAMP_ZONE=America/Bogota

# Ámbito académico:
# - PRODUCCION: requiere manifiesto de consentimiento y política de inicio en /etc/sps/trust/
# - LABORATORIO: solo para demostraciones/staging con consentimiento sintético
ACADEMIC_RUNTIME_SCOPE=PRODUCCION
IDENTITY_CONSENT_APPROVAL_MANIFEST=
IDENTITY_CONSENT_APPROVAL_SHA256=
IDENTITY_CONSENT_APPROVAL_PUBLIC_KEY=
PARTICIPATION_START_POLICY_FILE=
PARTICIPATION_START_POLICY_SHA256=

# Correo SMTP durable (Gmail SMTP o servidor institucional)
# Clave Fernet: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCHEDULING_MAIL_ENABLED=false
SCHEDULING_MAIL_HOST=smtp.gmail.com
SCHEDULING_MAIL_PORT=587
SCHEDULING_MAIL_TLS=STARTTLS
SCHEDULING_MAIL_FROM=adminsps8@gmail.com
SCHEDULING_MAIL_USERNAME=adminsps8@gmail.com
SCHEDULING_MAIL_PASSWORD=
SCHEDULING_MAIL_ENCRYPTION_KEY=
# En VPS público usar URL HTTPS exacta del dominio (ejemplo: https://sps.tudominio.edu.co)
SCHEDULING_MAIL_PUBLIC_URL=https://sps.tudominio.edu.co
