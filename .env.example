# Copiar a .env en la raíz del repositorio. No subir el archivo .env.
APP_NAME="SPS API"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sps
POSTGRES_USER=sps
# Asignar una contraseña local antes de usar la BD o Docker Compose.
POSTGRES_PASSWORD=
API_BIND_HOST=127.0.0.1
API_PORT=8000

# Identity: definir una clave aleatoria de al menos 32 bytes; no subirla a Git.
# Sin clave o dominios institucionales aprobados, el acceso permanece cerrado.
IDENTITY_JWT_SECRET=
IDENTITY_JWT_ISSUER=sps-api
IDENTITY_JWT_AUDIENCE=sps
IDENTITY_JWT_MINUTES=15
# Array JSON; sustituir por los dominios institucionales confirmados.
IDENTITY_INSTITUTIONAL_DOMAINS=[]

# Zona IANA acordada para los timestamps históricos sin offset.
# Definirla explícitamente según los datos del despliegue antes de arrancar Compose.
PARTICIPATION_TIMESTAMP_ZONE=

# Archivos confiables proporcionados por el operador. Vacío mantiene inicio cerrado.
# El paquete LABORATORIO nunca autoriza un despliegue PRODUCCION.
# En contenedores se requieren rutas internas y montaje externo de solo lectura.
ACADEMIC_RUNTIME_SCOPE=
IDENTITY_CONSENT_APPROVAL_MANIFEST=
IDENTITY_CONSENT_APPROVAL_SHA256=
IDENTITY_CONSENT_APPROVAL_PUBLIC_KEY=
PARTICIPATION_START_POLICY_FILE=
PARTICIPATION_START_POLICY_SHA256=

# Correo opcional. Habilitar solo con proveedor, remitente y URL confirmados.
# Puerto y transporte explícitos. STARTTLS o SSL para el proveedor.
# LAB_LOOPBACK se limita al capturador local de las pruebas.
# La clave Fernet protege los códigos pendientes. Mantenerla fuera de Git.
SCHEDULING_MAIL_ENABLED=false
SCHEDULING_MAIL_HOST=
SCHEDULING_MAIL_PORT=
SCHEDULING_MAIL_TLS=
SCHEDULING_MAIL_FROM=
SCHEDULING_MAIL_USERNAME=
SCHEDULING_MAIL_PASSWORD=
SCHEDULING_MAIL_ENCRYPTION_KEY=
SCHEDULING_MAIL_PUBLIC_URL=
