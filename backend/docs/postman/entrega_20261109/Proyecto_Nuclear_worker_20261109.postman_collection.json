              "pm.test('HTTP exacto 200',()=>pm.response.to.have.status(200));",
              "if (pm.request.method !== 'HEAD' && (pm.response.headers.get('Content-Type')||'').includes('json')) {",
              "const j=pm.response.json();",
              "function claves(v) { if (!v || typeof v!=='object') return []; return Object.keys(v).concat(...Object.values(v).map(claves)); }",
              "pm.test('Sin credenciales privadas',()=>pm.expect(claves(j)).not.to.include.any.members(['clave_hash','password','secreto','jwt_secret','codigo_hash']));",
              "}",
              "pm.test('Estado esperado',()=>pm.expect(pm.response.json().estado).to.eql('FINALIZADO'));pm.test('Edición histórica',()=>pm.expect(pm.response.json().version_caso_id).to.eql(pm.variables.get('version_id')));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "WORKER 3 — después de segundo w: FINALIZADO",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/scheduling/sesiones/{{worker_sesion_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_docente}}",
              "type": "string"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP exacto 200',()=>pm.response.to.have.status(200));",
              "if (pm.request.method !== 'HEAD' && (pm.response.headers.get('Content-Type')||'').includes('json')) {",
              "const j=pm.response.json();",
              "function claves(v) { if (!v || typeof v!=='object') return []; return Object.keys(v).concat(...Object.values(v).map(claves)); }",
              "pm.test('Sin credenciales privadas',()=>pm.expect(claves(j)).not.to.include.any.members(['clave_hash','password','secreto','jwt_secret','codigo_hash']));",
              "}",
              "pm.test('Estado esperado',()=>pm.expect(pm.response.json().estado).to.eql('FINALIZADO'));pm.test('Edición histórica',()=>pm.expect(pm.response.json().version_caso_id).to.eql(pm.variables.get('version_id')));"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
