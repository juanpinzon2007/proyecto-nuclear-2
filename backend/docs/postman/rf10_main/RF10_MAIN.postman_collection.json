              }
            ],
            "url": "{{base_url}}/api/v1/identity/auth/estudiantes",
            "body": {
              "mode": "raw",
              "raw": "{\"correo\": \"{{correo_estudiante}}\", \"codigo_convocatoria\": \"{{codigo_estudiante}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Operación REAL de app.main. Intento/consentimiento preparados previamente en LAB; no demuestra inicio productivo ni aprobación integral RF-10."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('rf10_preparado')!=='SOLO_LAB'||Number(pm.environment.get('rf10_paso')||0)!==0){if(pm.execution&&pm.execution.skipRequest)pm.execution.skipRequest();throw new Error('Prepare RF-10 y siga el orden.');}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP exacto 200',()=>pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('Contrato JSON',()=>pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Sin secretos privados',()=>{const t=pm.response.text();pm.expect(t).not.to.include('clave_hash');pm.expect(t).not.to.include('codigo_hash');});",
                  "pm.environment.set('token_estudiante',pm.response.json().access_token);",
                  "if(pm.response.code===200)pm.environment.set('rf10_paso',1);"
                ]
              }
            }
          ]
        },
